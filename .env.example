# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI Images (single-image posts) ───────────────────────────────────────
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium

# ── Apify (LinkedIn post scraping) ───────────────────────────────────────────
APIFY_TOKEN=

# ── Google Sheets ─────────────────────────────────────────────────────────────
SHEETS_ID=                       # Long ID from your Google Sheet URL
GOOGLE_CREDENTIALS_PATH=./credentials/sheets-service-account.json

# ── LinkedIn API (post analytics) ────────────────────────────────────────────
# From LinkedIn Developer Portal → your app → OAuth 2.0 tokens
# Needs: r_organization_social + w_organization_social + rw_organization_admin
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=        # Numeric org ID (urn:li:organization:XXXXXXXX)
LINKEDIN_API_VERSION=202604

# ── Offer copy — change without touching scripts ───────────────────────────
OFFER_MONTHLY_PRICE=$5.99/mo
OFFER_LIFETIME_PRICE=$29.99
OFFER_LIMIT=First 1,000 only
OFFER_CTA_TEXT=Link in Bio
